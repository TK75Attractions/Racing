   rgp::Status s;
   s.ads = adsOnline;
   for (size_t i = 0; i < PEDAL_COUNT; ++i) s.ads = s.ads && pedalConnected[i] && pedalSampled[i];
-  s.imu = anyHandleOnline();
+  s.imu = protocol.p1SteeringOnly() ? handles[0].online : anyHandleOnline();
   s.angle = s.imu;
