+void FirmwareDevice::reportInputDevices(uint32_t now) {
+  for (auto& h : handles) {
+    if (h.online) protocol.send("SYS", "DEVICE,IMU," + addressText(h.address) + "," + addressText(h.imu.getWhoAmI()), now);
+    else protocol.event("IMU_LOST," + addressText(h.address), now);
+  }
+}
