<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <Content Include="../../Assets/StreamingAssets/Dashboard/*.html;../../Assets/StreamingAssets/Dashboard/*.js;../../Assets/StreamingAssets/Dashboard/*.css;../../Assets/StreamingAssets/Dashboard/*.svg;../../Assets/StreamingAssets/Dashboard/*.json;../../Assets/StreamingAssets/Dashboard/*.png;../../Assets/StreamingAssets/Dashboard/*.webmanifest"
             Link="Dashboard/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
